import { Theme } from "theme.slint";
import { AppState, ActiveTab } from "globals.slint";
import { ConnectionBar } from "components/connection_bar.slint";
import { StatusBar } from "components/status_bar.slint";
import { KeySelector } from "components/key_selector.slint";
import { TabKeymap } from "tabs/tab_keymap.slint";
import { TabAdvanced } from "tabs/tab_advanced.slint";
import { TabMacros } from "tabs/tab_macros.slint";
import { TabStats } from "tabs/tab_stats.slint";
import { TabSettings } from "tabs/tab_settings.slint";
import { TabTools } from "tabs/tab_tools.slint";
import { TabDongle } from "tabs/tab_dongle.slint";

export { AppState, Theme }
export { ConnectionBridge, KeymapBridge, SettingsBridge, StatsBridge, AdvancedBridge, MacroBridge, FlasherBridge, KeySelectorBridge, LayoutBridge, ToolsBridge, DongleBridge } from "globals.slint";

component DarkTab inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: root.active ? Theme.bg-secondary : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    Text {
        text: root.title;
        color: root.active ? Theme.fg-primary : #9a9ebb;
        font-size: 13px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.accent-purple : transparent;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component MainWindow inherits Window {
    title: "KeSp Controller";
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 600px;
    min-height: 450px;
    background: Theme.bg-primary;

    in-out property <int> current-tab: 0;

    VerticalLayout {
        ConnectionBar { }

        // Tab bar
        Rectangle {
            height: 34px;
            background: Theme.bg-primary;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;

                DarkTab { title: "Keymap"; active: root.current-tab == 0; enabled: AppState.keyboard-reachable; clicked => { root.current-tab = 0; AppState.tab-changed(0); } }
                DarkTab { title: "Advanced"; active: root.current-tab == 1; enabled: AppState.keyboard-reachable; clicked => { root.current-tab = 1; AppState.tab-changed(1); } }
                DarkTab { title: "Macros"; active: root.current-tab == 2; enabled: AppState.keyboard-reachable; clicked => { root.current-tab = 2; AppState.tab-changed(2); } }
                DarkTab { title: "Stats"; active: root.current-tab == 3; enabled: AppState.keyboard-reachable; clicked => { root.current-tab = 3; AppState.tab-changed(3); } }
                DarkTab { title: "Settings"; active: root.current-tab == 4; clicked => { root.current-tab = 4; AppState.tab-changed(4); } }
                DarkTab { title: "Tools"; active: root.current-tab == 5; clicked => { root.current-tab = 5; AppState.tab-changed(5); } }
                DarkTab { title: "Dongle"; active: root.current-tab == 6; clicked => { root.current-tab = 6; AppState.tab-changed(6); } }
            }
        }

        // Tab content
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-secondary;
            border-radius: 4px;

            if root.current-tab == 0 : TabKeymap { }
            if root.current-tab == 1 : TabAdvanced { }
            if root.current-tab == 2 : TabMacros { }
            if root.current-tab == 3 : TabStats { }
            if root.current-tab == 4 : TabSettings { }
            if root.current-tab == 5 : TabTools { }
            if root.current-tab == 6 : TabDongle { }
        }

        StatusBar { }
    }

    // Modal overlay (above everything)
    KeySelector { }

    // Sec Confirm posée sur la moitié droite : le firmware ignorera l'appui.
    // On avertit sans empêcher — la touche est bien assignée.
    if AppState.sec-confirm-misplaced : Rectangle {
        background: #000000aa;

        TouchArea {
            clicked => { AppState.sec-confirm-misplaced = false; }
        }

        Rectangle {
            width: 340px;
            height: 170px;
            border-radius: 8px;
            background: Theme.bg-secondary;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: "Sec Confirm sur la moitié droite";
                    color: Theme.accent-orange;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "La touche est assignée, mais le firmware ignorera l'appui : "
                        + "une confirmation venue de la moitié droite passe par une radio "
                        + "non authentifiée. Place-la sur la moitié gauche pour qu'elle agisse.";
                    color: Theme.fg-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 30px;
                    width: 90px;
                    border-radius: 5px;
                    background: ta.has-hover ? Theme.accent-purple : Theme.bg-surface;
                    ta := TouchArea {
                        clicked => { AppState.sec-confirm-misplaced = false; }
                    }
                    Text {
                        text: "Compris";
                        color: Theme.fg-primary;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}
